<div class="related-grid article-end-related-grid">
{% for card in cards %}{% if card.kind == 'article' %}<a class="related-card article-end-related-card" href="{{ card.href }}"{% for key,value in card.attributes %} {{ key }}="{{ value }}"{% endfor %}>
  <span class="article-end-related-media"><img src="{{ card.image }}" alt="{{ card.alt }}" loading="lazy" decoding="async"></span>
  <span class="article-end-related-copy">{{ card.contentHtml | safe }}</span>
</a>{% else %}{{ card.raw | safe }}{% endif %}
{% endfor %}</div>
