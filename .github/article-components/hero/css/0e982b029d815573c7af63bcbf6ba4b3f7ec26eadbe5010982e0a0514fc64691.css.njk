

    .article-hero{
      position:relative;
      overflow:hidden;
      border:1px solid var(--line);
      border-radius:30px;
      background:
        linear-gradient(90deg, rgba(248,251,255,.98) 0%, rgba(248,251,255,.95) 34%, rgba(248,251,255,.76) 50%, rgba(248,251,255,.18) 72%, rgba(248,251,255,0) 100%),
        {{ urls[0] | safe }} right center / auto 100% no-repeat,
        #f8fbff;
      box-shadow:var(--shadow);
      min-height:400px;
    }