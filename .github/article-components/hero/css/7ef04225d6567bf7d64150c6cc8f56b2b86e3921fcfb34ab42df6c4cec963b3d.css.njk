

    .article-hero{
      position:relative;
      overflow:hidden;
      border:1px solid var(--line);
      border-radius:32px;
      box-shadow:var(--shadow);
      background:
        linear-gradient(90deg, rgba(255,255,255,.98) 0%, rgba(255,255,255,.95) 38%, rgba(255,255,255,.82) 58%, rgba(255,255,255,.42) 76%, rgba(255,255,255,.08) 100%),
        #f8fbff;
      min-height:400px;
      isolation:isolate;
    }