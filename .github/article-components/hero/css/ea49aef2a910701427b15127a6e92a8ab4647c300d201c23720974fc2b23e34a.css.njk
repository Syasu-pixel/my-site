

    .article-hero{
      position:relative;
      overflow:hidden;
      border:1px solid var(--line);
      border-radius:30px;
      background:
        linear-gradient(90deg, rgba(255,255,255,.98) 0%, rgba(255,255,255,.95) 38%, rgba(255,255,255,.82) 56%, rgba(255,255,255,.46) 74%, rgba(255,255,255,.12) 100%),
        #f8fbff;
      box-shadow:var(--shadow);
      min-height:400px;
      isolation:isolate;
    }