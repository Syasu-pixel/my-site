
    .article-hero{position:relative;overflow:hidden;border:1px solid var(--line);border-radius:30px;background-image:linear-gradient(90deg,rgba(255,255,255,.99) 0%,rgba(255,255,255,.97) 28%,rgba(255,255,255,.86) 45%,rgba(255,255,255,.36) 59%,rgba(255,255,255,.02) 76%),{{ urls[0] | safe }};background-size:100% 100%,auto 100%;background-position:center,right center;background-repeat:no-repeat,no-repeat;background-color:#fff;box-shadow:var(--shadow);min-height:410px}