<header class="site-header">
    <div class="site-header-inner">
      <a class="brand" href="../index.html" aria-label="Denki Control Lab home">
        <img class="brand-logo" src="../../assets/images/common/site-logo-dcl-48.png" alt="Denki Control Lab logo" width="48" height="48">
        <span class="brand-copy">
          <span class="brand-title">Denki Control Lab</span>
          <span class="brand-sub">Practical guides for electrical control and PLC basics</span>
        </span>
      </a>

      <div class="language-menu">
        <button class="language-menu-button" type="button" id="languageMenuButton" aria-expanded="false" aria-controls="languageMenuPanel">
          <span class="language-menu-icon" aria-hidden="true">🌐</span>
          <span class="language-menu-current">English</span>
        </button>
        <div class="language-menu-panel" id="languageMenuPanel" hidden>
          <a class="language-menu-item" href="../../articles/{{ shell.articleFile }}" lang="ja">
            <span class="language-menu-flag" aria-hidden="true">🇯🇵</span>
            <span>
              <strong>日本語</strong>
              <small>Japanese article</small>
            </span>
          </a>
          <a class="language-menu-item is-active" href="./{{ shell.articleFile }}" lang="en" aria-current="page">
            <span class="language-menu-flag" aria-hidden="true">🇺🇸</span>
            <span>
              <strong>English</strong>
              <small>English article</small>
            </span>
          </a>
        </div>
      </div>

      <form class="header-search search-box" id="siteSearch" aria-label="Site search" role="search">
        <label class="sr-only" for="site-search-input">Search this site</label>
        <input id="site-search-input" class="search-box-input" type="search" placeholder="Search" autocomplete="off" enterkeyhint="search">
        <button class="search-box-button" type="submit" aria-label="Search">
          <span class="header-search-icon" aria-hidden="true"></span>
        </button>
        <div class="search-box-panel" id="site-search-panel" hidden>
          <ul class="search-box-results" id="site-search-results"></ul>
          <p class="search-box-empty" id="site-search-empty" hidden>No matching articles found.</p>
        </div>
      </form>
    </div>
  </header>