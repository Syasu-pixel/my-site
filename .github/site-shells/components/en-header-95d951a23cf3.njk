<header class="site-header">
    <div class="site-header-inner">
      <a href="../" class="brand" aria-label="Go to English top page">
      <img src="../../assets/images/common/site-logo-dcl.png" alt="Denki Control Lab logo" class="brand-logo">
      <div class="brand-copy">
        <p class="brand-title">Denki Control Lab</p>
        <p class="brand-sub">Practical electrical control notes</p>
      </div>
    </a>

      <nav class="header-nav" aria-label="Header links">
        <a class="header-link" href="../index.html">Home</a>
        <a class="header-link" href="../categories/circuit-basics.html">Circuit Basics</a>
      </nav>

      <div class="language-menu">
        <button class="language-menu-button" type="button" id="languageMenuButton" aria-expanded="false" aria-controls="languageMenuPanel">
          <span class="language-menu-icon">🌐</span>
          <span class="language-menu-current">English</span>
        </button>
        <div class="language-menu-panel" id="languageMenuPanel" hidden>
          <a class="language-menu-item" href="../../articles/{{ shell.articleFile }}">
            <span class="language-menu-flag">🇯🇵</span>
            <span><strong>日本語</strong><small>日本語記事</small></span>
          </a>
          <a class="language-menu-item is-active" href="./{{ shell.articleFile }}" aria-current="page">
            <span class="language-menu-flag">🇺🇸</span>
            <span><strong>English</strong><small>English article</small></span>
          </a>
        </div>
      </div>

      <form class="header-search search-box" id="siteSearch" role="search">
        <label class="sr-only" for="site-search-input">Search by keyword</label>
        <input class="search-box-input" id="site-search-input" type="search" placeholder="Search by keyword" autocomplete="off">
        <button class="search-box-button" type="submit" aria-label="Search">
          <span class="header-search-icon" aria-hidden="true"></span>
        </button>
        <div class="search-box-panel" id="site-search-panel" hidden>
          <ul class="search-box-results" id="site-search-results"></ul>
          <p class="search-box-empty" id="site-search-empty" hidden>No matching articles found.</p>
        </div>
      </form>
    </div>
  </header>