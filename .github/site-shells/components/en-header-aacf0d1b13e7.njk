<header class="site-header">
    <div class="site-header-inner">
      <a href="../" class="brand" aria-label="Go to English top page">
        <img src="../../assets/images/common/site-logo-dcl.png" alt="Denki Control Lab logo" class="brand-logo">
        <div class="brand-copy">
          <p class="brand-title">Denki Control Lab</p>
          <p class="brand-sub">Practical electrical control notes</p>
        </div>
      </a>
      <div class="language-menu" aria-label="Language and region switch">
        <button type="button" class="language-menu-button" id="languageMenuButton" aria-expanded="false" aria-controls="languageMenuPanel" aria-label="Switch language and region">
          <span class="language-menu-icon" aria-hidden="true">🌐</span>
          <span class="language-menu-current">United States</span>
        </button>
        <div class="language-menu-panel" id="languageMenuPanel" hidden>
          <a href="../../articles/{{ shell.articleFile }}" class="language-menu-item" lang="ja"><span class="language-menu-flag" aria-hidden="true">🇯🇵</span><span><strong>Japan</strong><small>Japanese article</small></span></a>
          <a href="./{{ shell.articleFile }}" class="language-menu-item is-active" lang="en" aria-current="page"><span class="language-menu-flag" aria-hidden="true">🇺🇸</span><span><strong>United States</strong><small>English article</small></span></a>
        </div>
      </div>
      <form class="header-search search-box" id="siteSearch" aria-label="Site search" role="search">
        <label class="sr-only" for="site-search-input">Site search</label>
        <input id="site-search-input" class="search-box-input" type="search" placeholder="Search by keyword" autocomplete="off" enterkeyhint="search">
        <button class="search-box-button" type="submit" aria-label="Search"><span class="header-search-icon" aria-hidden="true"></span></button>
        <div id="site-search-panel" class="search-box-panel" hidden><ul id="site-search-results" class="search-box-results"></ul><p id="site-search-empty" class="search-box-empty" hidden>No matching articles found.</p></div>
      </form>
    </div>
  </header>