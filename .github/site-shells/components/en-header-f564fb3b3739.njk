<header class="site-header">
    <div class="site-header-inner">
      <a href="../" class="brand" aria-label="Go to English top page">
      <img src="../../assets/images/common/site-logo-dcl.png" alt="Denki Control Lab logo" class="brand-logo">
      <div class="brand-copy">
        <p class="brand-title">Denki Control Lab</p>
        <p class="brand-sub">Practical electrical control notes</p>
      </div>
    </a>

      <div class="language-menu">
        <button class="language-menu-button" type="button" id="language-menu-button" aria-expanded="false" aria-controls="language-menu-panel">
          <span class="language-menu-icon" aria-hidden="true">🌐</span>
          <span class="language-menu-current">United States</span>
        </button>
        <div class="language-menu-panel" id="language-menu-panel" hidden>
          <a class="language-menu-item is-active" href="./{{ shell.articleFile }}" lang="en" aria-current="page">
            <span class="language-menu-flag" aria-hidden="true">🇺🇸</span>
            <span><strong>United States</strong><small>English article</small></span>
          </a>
          <a class="language-menu-item" href="../../articles/{{ shell.articleFile }}" lang="ja">
            <span class="language-menu-flag" aria-hidden="true">🇯🇵</span>
            <span><strong>日本語</strong><small>Japanese article</small></span>
          </a>
        </div>
      </div>

      <form class="header-search search-box" id="siteSearch" aria-label="Search this site" role="search">
        <label class="sr-only" for="site-search-input">Search this site</label>
        <input id="site-search-input" class="search-box-input" type="search" placeholder="Search by keyword" autocomplete="off" enterkeyhint="search">
        <button class="search-box-button" type="submit" aria-label="Search">
          <span class="header-search-icon" aria-hidden="true"></span>
        </button>
        <div class="search-box-panel" id="site-search-panel" hidden>
          <ul class="search-box-results" id="site-search-results"></ul>
          <p class="search-box-empty" id="site-search-empty" hidden>No matching articles found.</p>
        </div>
      </form>
    </div>
  </header>