<header class="site-header">
<div class="site-header-inner">
<a aria-label="トップページへ移動" class="brand" href="../">
<img alt="電気と制御の実務メモ ロゴ" class="brand-logo" src="../assets/images/common/site-logo-dcl.png"/>
<div class="brand-copy">
<p class="brand-title">電気と制御の実務メモ</p>
<p class="brand-sub">現場で使える考え方と制御の基礎をわかりやすく解説</p>
</div>
</a>
<div aria-label="言語と地域の切り替え" class="language-menu">
<button aria-controls="languageMenuPanel" aria-expanded="false" aria-label="言語と地域を切り替える" class="language-menu-button" id="languageMenuButton" type="button">
<span aria-hidden="true" class="language-menu-icon">🌐</span>
<span class="language-menu-current">Japan</span>
</button>
<div class="language-menu-panel" hidden="" id="languageMenuPanel">
<a aria-current="page" class="language-menu-item is-active" href="./{{ shell.articleFile }}" lang="ja">
<span aria-hidden="true" class="language-menu-flag">🇯🇵</span>
<span>
<strong>Japan</strong>
<small>日本語記事</small>
</span>
</a>
</div>
</div>
<form aria-label="サイト内検索" class="header-search search-box" id="siteSearch" role="search">
<label class="sr-only" for="site-search-input">サイト内検索</label>
<input autocomplete="off" class="search-box-input" enterkeyhint="search" id="site-search-input" placeholder="キーワードで検索" type="search"/>
<button aria-label="検索" class="search-box-button" type="submit">
<span aria-hidden="true" class="header-search-icon"></span>
</button>
<div class="search-box-panel" hidden="" id="site-search-panel">
<ul class="search-box-results" id="site-search-results"></ul>
<p class="search-box-empty" hidden="" id="site-search-empty">該当する記事がありません</p>
</div>
</form>
</div>
</header>