<header class="site-header">
    <div class="site-header-inner">
      <a href="../" class="brand" aria-label="トップページへ移動">
        <img src="../assets/images/common/site-logo-dcl.png" alt="電気と制御の実務メモ ロゴ" class="brand-logo">
        <div class="brand-copy">
          <p class="brand-title">電気と制御の実務メモ</p>
          <p class="brand-sub">現場で使える考え方と制御の基礎をわかりやすく解説</p>
        </div>
      </a>
      <div class="language-menu" aria-label="言語と地域の切り替え">
        <button type="button" class="language-menu-button" id="languageMenuButton" aria-expanded="false" aria-controls="languageMenuPanel" aria-label="言語と地域を切り替える">
          <span class="language-menu-icon" aria-hidden="true">🌐</span><span class="language-menu-current">Japan</span>
        </button>
        <div class="language-menu-panel" id="languageMenuPanel" hidden>
          <a href="./{{ shell.articleFile }}" class="language-menu-item is-active" lang="ja" aria-current="page"><span class="language-menu-flag" aria-hidden="true">🇯🇵</span><span><strong>日本語記事</strong><small>日本語記事</small></span></a>
          <a href="../en/" class="language-menu-item" lang="en"><span class="language-menu-flag" aria-hidden="true">🇺🇸</span><span><strong>English top</strong><small>English top</small></span></a>
        </div>
      </div>
      <form class="header-search search-box" id="siteSearch" aria-label="サイト内検索" role="search">
        <label class="sr-only" for="site-search-input">サイト内検索</label>
        <input id="site-search-input" class="search-box-input" type="search" placeholder="キーワードで検索" autocomplete="off" enterkeyhint="search">
        <button class="search-box-button" type="submit" aria-label="検索"><span class="header-search-icon" aria-hidden="true"></span></button>
        <div class="search-box-panel" id="site-search-panel" hidden>
          <ul class="search-box-results" id="site-search-results"></ul>
          <p class="search-box-empty" id="site-search-empty" hidden>該当する記事がありません</p>
        </div>
      </form>
    </div>
  </header>