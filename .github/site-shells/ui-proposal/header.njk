<header class="site-header dc-shell">
  <script data-dc-theme-init>(()=>{let saved=null,explicit=false;try{explicit=localStorage.getItem('dc-theme-explicit-v2')==='1';if(explicit)saved=localStorage.getItem('dc-theme')}catch{}let systemDark=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches;try{const v=navigator.preferences?.colorScheme?.value;if(v==='dark')systemDark=true;else if(v==='light')systemDark=false}catch{}document.documentElement.dataset.dcTheme=explicit?(saved==='dark'?'dark':'light'):(systemDark?'dark':'light')})()</script>
  <div class="dc-bar">
    <a class="dc-brand" href="{{ home }}" aria-label="{{ homeLabel }}">
      <img src="{{ assetRoot }}images/common/site-logo-dcl.png" alt="" width="46" height="46">
      <span><strong>{{ title }}</strong><small>{{ subtitle }}</small></span>
    </a>
    <div class="dc-actions">
      {% if lang == 'ja' %}<a class="dc-consult" href="/services/gxworks2-online-support.html"><span>GX Works2</span><strong>{{ consult }}</strong></a>{% endif %}
      <button class="dc-icon-button" id="dc-search-toggle" aria-label="{{ search }}" aria-expanded="false" aria-controls="dc-search-drawer" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 5 5"></path></svg><span>{{ searchShort }}</span></button>
      <button class="dc-icon-button" id="dc-menu-toggle" aria-label="{{ menu }}" aria-expanded="false" aria-controls="dc-menu-drawer" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg><span>{{ menu }}</span></button>
    </div>
  </div>
  <div class="dc-drawer dc-search-drawer" id="dc-search-drawer" hidden>
    <form class="search-box dc-search-form" id="siteSearch" aria-label="{{ search }}" role="search">
      <label class="dc-search-label" for="site-search-input">{{ search }}</label>
      <div class="dc-search-row"><input id="site-search-input" class="search-box-input" type="search" placeholder="{{ placeholder }}" autocomplete="off" enterkeyhint="search"><button class="search-box-button dc-submit" type="submit">{{ searchShort }}</button></div>
      <div class="search-box-panel" id="site-search-panel" hidden><ul class="search-box-results" id="site-search-results"></ul><p class="search-box-empty" id="site-search-empty" hidden>{{ noResults }}</p></div>
    </form>
  </div>
  <nav class="dc-drawer dc-menu-drawer" id="dc-menu-drawer" aria-label="{{ menu }}" hidden>
    <a class="dc-contact" href="{{ contactUrl }}"><span>{{ contact }}</span><span aria-hidden="true">↗</span></a>
    <div class="dc-theme">
      <p class="dc-theme-caption"><span class="dc-lang-ja">表示テーマ</span><span class="dc-lang-en">DISPLAY THEME</span></p>
      <button class="dc-theme-toggle" id="dc-theme-toggle" type="button" role="switch" aria-checked="false">
        <span class="dc-theme-symbol" aria-hidden="true">🌙</span>
        <span class="dc-theme-name"><span class="dc-lang-ja">ダークモード</span><span class="dc-lang-en">Dark mode</span></span>
        <span class="dc-theme-switch" aria-hidden="true"></span>
      </button>
    </div>
    <div class="dc-language"><p>{{ languageLabel }}</p><div class="dc-current"><strong lang="{{ lang }}">{{ currentLanguage }}</strong><span>{{ currentLabel }}</span></div>
    {% if counterpart %}<a class="dc-alternative" href="{{ counterpart }}" lang="{{ otherLang }}" hreflang="{{ otherLang }}"><span>{{ otherLanguage }}</span><span aria-hidden="true">→</span></a>{% endif %}</div>
  </nav>
</header>